type Query {
    accounts: [AccountResult]
    accountById (accountId: String!) : AccountResult
}

union AccountResult = BankAccount | CreditAccount

type BankAccount {
    id: ID!
    client: Client!
    currency: Currency!
    balance: Float!
    status: String!
}

type CreditAccount {
    id: ID!
    client: Client!
    creditLimit: Float!
    outstandingBalance: Float!
    status: String!
}

type Client {
    id: ID!
    firstName: String!
    middleName: String
    lastName: String
}

enum Currency {
    EUR, CAD, USD
}
